  "author": {
    "name": "Richard McQuiston",
    "email": "richard.mcquiston01@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/html-to-lvgl.git"
  },
  "homepage": "https://github.com/RichardMcQuiston01/html-to-lvgl#readme",
