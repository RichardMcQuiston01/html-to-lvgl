<screen>
  <animations>
    <timeline name="body_div_3_slide_in">
      <animation prop="translate_x" target="nav_sheet" start="-216" end="0" duration="250" />
    </timeline>
    <timeline name="body_div_3_slide_out">
      <animation prop="translate_x" target="nav_sheet" start="0" end="-216" duration="250" />
    </timeline>
    <timeline name="body_div_4_slide_in">
      <animation prop="translate_x" target="filters" start="241" end="0" duration="250" />
    </timeline>
    <timeline name="body_div_4_slide_out">
      <animation prop="translate_x" target="filters" start="0" end="241" duration="250" />
    </timeline>
  </animations>
  <view width="320" height="240" style_bg_color="0xfafafa" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="12" style_pad_right="12" style_pad_top="12" style_pad_bottom="12" flex_flow="column" style_pad_row="8" style_pad_column="8" scrollable="false" style_text_font="montserrat_16" style_text_color="0x000000">
    <lv_label name="label" text="Inbox" style_text_font="montserrat_18" style_text_color="0x212529" />
    <lv_label name="note" text="Open a drawer from either edge." style_text_font="montserrat_12" style_text_color="0x6c757d" />
    <lv_obj name="row" width="296" height="30" style_bg_opa="0" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="0" style_pad_right="0" style_pad_top="0" style_pad_bottom="0" flex_flow="row" style_pad_row="8" style_pad_column="8" scrollable="false">
      <lv_button name="open_plain" width="54" height="30" style_bg_color="0x0d6efd" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
        <lv_label name="open_plain_2" align="center" text="Menu" style_text_font="montserrat_12" style_text_color="0xffffff" style_text_align="center" />
        <subject_set_int_event subject="drawer_body_div_3_open" value="1" />
        <play_timeline_event target="self" timeline="body_div_3_slide_in" />
      </lv_button>
      <lv_button name="open_mui" width="72" height="30" style_bg_color="0x1976d2" style_border_width="0" style_radius="4" style_shadow_color="0x000000" style_shadow_opa="31" style_shadow_width="5" style_shadow_offset_y="1" style_pad_all="0">
        <lv_label name="open_mui_2" align="center" text="FILTERS" style_text_font="montserrat_12" style_text_color="0xffffff" style_text_align="center" />
        <subject_set_int_event subject="drawer_body_div_4_open" value="1" />
        <play_timeline_event target="self" timeline="body_div_4_slide_in" />
      </lv_button>
    </lv_obj>
    <lv_obj name="scrim" x="-12" y="-12" ignore_layout="true" floating="true" width="320" height="240" style_bg_color="0x000000" style_bg_opa="128" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_all="0" scrollable="false">
      <subject_set_int_event subject="drawer_body_div_3_open" value="0" />
      <play_timeline_event target="self" timeline="body_div_3_slide_out" />
      <bind_flag_if_eq subject="drawer_body_div_3_open" flag="hidden" ref_value="0" />
    </lv_obj>
    <lv_obj name="nav_sheet" x="-12" y="-12" ignore_layout="true" floating="true" style_translate_x="-216" width="200" height="240" style_bg_color="0xffffff" style_border_width="0" style_radius="0" style_shadow_color="0x000000" style_shadow_opa="64" style_shadow_width="12" style_shadow_offset_x="4" style_pad_left="16" style_pad_right="16" style_pad_top="16" style_pad_bottom="16" flex_flow="column" style_pad_row="10" style_pad_column="10" scrollable="false">
      <lv_label name="label_2" text="Navigation" style_text_font="montserrat_16" style_text_color="0x212529" />
      <lv_label name="label_3" text="Inbox" style_text_font="montserrat_12" style_text_color="0x495057" />
      <lv_label name="label_4" text="Starred" style_text_font="montserrat_12" style_text_color="0x495057" />
      <lv_label name="label_5" text="Drafts" style_text_font="montserrat_12" style_text_color="0x495057" />
      <lv_button name="close" style_margin_top="75" width="168" height="30" style_bg_color="0xe9ecef" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
        <lv_label name="close_2" align="center" text="Close" style_text_font="montserrat_12" style_text_color="0x212529" style_text_align="center" />
        <subject_set_int_event subject="drawer_body_div_3_open" value="0" />
        <play_timeline_event target="self" timeline="body_div_3_slide_out" />
      </lv_button>
    </lv_obj>
    <lv_obj name="drawer_scrim" x="-12" y="-12" ignore_layout="true" floating="true" width="320" height="240" style_bg_color="0x000000" style_bg_opa="128" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_all="0" scrollable="false">
      <subject_set_int_event subject="drawer_body_div_4_open" value="0" />
      <play_timeline_event target="self" timeline="body_div_4_slide_out" />
      <bind_flag_if_eq subject="drawer_body_div_4_open" flag="hidden" ref_value="0" />
    </lv_obj>
    <lv_obj name="filters" x="108" y="-12" ignore_layout="true" floating="true" style_translate_x="241" width="200" height="240" style_bg_color="0xffffff" style_border_width="0" style_radius="0" style_shadow_color="0x000000" style_shadow_opa="31" style_shadow_width="30" style_shadow_offset_y="6" style_shadow_spread="5" style_pad_left="16" style_pad_right="16" style_pad_top="16" style_pad_bottom="16" flex_flow="column" style_pad_row="10" style_pad_column="10" scrollable="false">
      <lv_label name="typography_h6" text="Filters" style_text_font="montserrat_16" style_text_color="0x000000" style_text_opa="222" />
      <lv_label name="list_item" text="Unread" style_text_font="montserrat_12" style_text_color="0x000000" style_text_opa="222" />
      <lv_label name="list_item_2" text="Attachments" style_text_font="montserrat_12" style_text_color="0x000000" style_text_opa="222" />
      <lv_label name="list_item_3" text="Last 7 days" style_text_font="montserrat_12" style_text_color="0x000000" style_text_opa="222" />
      <lv_button name="button" style_margin_top="79" width="168" height="26" style_bg_opa="0" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
