<screen>
  <animations>
    <timeline name="body_div_2_slide_in">
      <animation prop="translate_y" target="top_sheet" start="-126" end="0" duration="250" />
    </timeline>
    <timeline name="body_div_2_slide_out">
      <animation prop="translate_y" target="top_sheet" start="0" end="-126" duration="250" />
    </timeline>
    <timeline name="body_div_3_slide_in">
      <animation prop="translate_y" target="bottom_sheet" start="126" end="0" duration="250" />
    </timeline>
    <timeline name="body_div_3_slide_out">
      <animation prop="translate_y" target="bottom_sheet" start="0" end="126" duration="250" />
    </timeline>
  </animations>
  <view width="320" height="240" style_bg_color="0xfafafa" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="12" style_pad_right="12" style_pad_top="12" style_pad_bottom="12" flex_flow="column" style_pad_row="8" style_pad_column="8" scrollable="false" style_text_font="montserrat_16" style_text_color="0x000000">
    <lv_label name="label" text="Edges" style_text_font="montserrat_18" style_text_color="0x212529" />
    <lv_obj name="row" width="296" height="30" style_bg_opa="0" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="0" style_pad_right="0" style_pad_top="0" style_pad_bottom="0" flex_flow="row" style_pad_row="8" style_pad_column="8" scrollable="false">
      <lv_button name="open_top" width="43" height="30" style_bg_color="0x0d6efd" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
        <lv_label name="open_top_2" align="center" text="Top" style_text_font="montserrat_12" style_text_color="0xffffff" style_text_align="center" />
        <subject_set_int_event subject="drawer_edges_body_div_2_open" value="1" />
        <play_timeline_event target="self" timeline="body_div_2_slide_in" />
      </lv_button>
      <lv_button name="open_bottom" width="62" height="30" style_bg_color="0x0d6efd" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
        <lv_label name="open_bottom_2" align="center" text="Bottom" style_text_font="montserrat_12" style_text_color="0xffffff" style_text_align="center" />
        <subject_set_int_event subject="drawer_edges_body_div_3_open" value="1" />
        <play_timeline_event target="self" timeline="body_div_3_slide_in" />
      </lv_button>
    </lv_obj>
    <lv_obj name="scrim" x="-12" y="-12" ignore_layout="true" floating="true" width="320" height="240" style_bg_color="0x000000" style_bg_opa="128" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_all="0" scrollable="false">
      <subject_set_int_event subject="drawer_edges_body_div_2_open" value="0" />
      <play_timeline_event target="self" timeline="body_div_2_slide_out" />
      <bind_flag_if_eq subject="drawer_edges_body_div_2_open" flag="hidden" ref_value="0" />
    </lv_obj>
    <lv_obj name="top_sheet" x="-12" y="-12" ignore_layout="true" floating="true" style_translate_y="-126" width="320" height="110" style_bg_color="0xffffff" style_border_width="0" style_radius="0" style_shadow_color="0x000000" style_shadow_opa="64" style_shadow_width="12" style_shadow_offset_y="4" style_pad_all="0" scrollable="false">
      <lv_label name="label_2" x="16" y="16" text="Top sheet" style_text_font="montserrat_16" style_text_color="0x212529" />
      <lv_button name="button" x="16" y="46" width="55" height="30" style_bg_color="0xe9ecef" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
        <lv_label name="label_3" align="center" text="Close" style_text_font="montserrat_12" style_text_color="0x212529" style_text_align="center" />
        <subject_set_int_event subject="drawer_edges_body_div_2_open" value="0" />
        <play_timeline_event target="self" timeline="body_div_2_slide_out" />
      </lv_button>
    </lv_obj>
    <lv_obj name="scrim_2" x="-12" y="-12" ignore_layout="true" floating="true" width="320" height="240" style_bg_color="0x000000" style_bg_opa="128" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_all="0" scrollable="false">
      <subject_set_int_event subject="drawer_edges_body_div_3_open" value="0" />
      <play_timeline_event target="self" timeline="body_div_3_slide_out" />
      <bind_flag_if_eq subject="drawer_edges_body_div_3_open" flag="hidden" ref_value="0" />
    </lv_obj>
    <lv_obj name="bottom_sheet" x="-12" y="118" ignore_layout="true" floating="true" style_translate_y="126" width="320" height="110" style_bg_color="0xffffff" style_border_width="0" style_radius="0" style_shadow_color="0x000000" style_shadow_opa="64" style_shadow_width="12" style_shadow_offset_y="-4" style_pad_all="0" scrollable="false">
      <lv_label name="label_4" x="16" y="16" text="Bottom sheet" style_text_font="montserrat_16" style_text_color="0x212529" />
      <lv_button name="button_2" x="16" y="46" width="55" height="30" style_bg_color="0xe9ecef" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
        <lv_label name="label_5" align="center" text="Close" style_text_font="montserrat_12" style_text_color="0x212529" style_text_align="center" />
        <subject_set_int_event subject="drawer_edges_body_div_3_open" value="0" />
        <play_timeline_event target="self" timeline="body_div_3_slide_out" />
      </lv_button>
    </lv_obj>
  </view>
</screen>
