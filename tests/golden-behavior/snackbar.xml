<screen>
  <view width="320" height="240" style_bg_color="0xfafafa" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="12" style_pad_right="12" style_pad_top="12" style_pad_bottom="12" flex_flow="column" style_pad_row="8" style_pad_column="8" scrollable="false" style_text_font="montserrat_16" style_text_color="0x000000">
    <lv_label name="label" text="Inbox" style_text_font="montserrat_18" style_text_color="0x212529" />
    <lv_label name="note" text="Messages appear over the page." style_text_font="montserrat_12" style_text_color="0x6c757d" />
    <lv_button name="show_toast" width="92" height="31" style_bg_color="0x0d6efd" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
      <lv_label name="show_toast_2" align="center" text="Show toast" style_text_font="montserrat_12" style_text_color="0xffffff" style_text_align="center" />
      <subject_set_int_event subject="snackbar_toast_open" value="1" />
    </lv_button>
    <lv_obj name="snackbar" x="0" y="120" ignore_layout="true" floating="true" width="296" height="43" style_bg_color="0x212529" style_border_width="0" style_radius="6" style_shadow_width="0" style_pad_left="12" style_pad_right="12" style_pad_top="10" style_pad_bottom="10" flex_flow="row" style_flex_main_place="space_between" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="0" style_pad_column="0" scrollable="false">
      <lv_label name="label_2" text="Draft saved" style_text_font="montserrat_12" style_text_color="0xffffff" />
      <lv_button name="button" width="66" height="23" style_bg_opa="0" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_all="0">
        <lv_label name="label_3" align="center" text="Dismiss" style_text_font="montserrat_12" style_text_color="0x6ea8fe" style_text_align="center" />
        <subject_set_int_event subject="snackbar_toast_open" value="0" />
      </lv_button>
      <bind_flag_if_eq subject="snackbar_toast_open" flag="hidden" ref_value="0" />
    </lv_obj>
    <lv_obj name="snackbar_2" x="-4" y="176" ignore_layout="true" floating="true" width="304" height="44" style_bg_opa="0" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="0" style_pad_right="0" style_pad_top="0" style_pad_bottom="0" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="0" style_pad_column="0" scrollable="false">
      <lv_obj name="alert" width="304" height="44" style_bg_color="0x323232" style_border_width="0" style_radius="4" style_shadow_color="0x000000" style_shadow_opa="31" style_shadow_width="18" style_shadow_offset_y="1" style_pad_left="16" style_pad_right="16" style_pad_top="6" style_pad_bottom="6" flex_flow="row_wrap" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="0" style_pad_column="0" scrollable="false">
        <lv_label name="snackbar_content_message" flex_grow="1" text="Note archived" style_text_font="montserrat_14" style_text_color="0xffffff" />
        <lv_obj name="snackbar_content_action" style_margin_left="16" style_margin_right="-8" width="84" height="30" style_bg_opa="0" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="0" style_pad_right="0" style_pad_top="0" style_pad_bottom="0" flex_flow="row" style_flex_cross_place="center" style_flex_track_place="center" style_pad_row="0" style_pad_column="0" scrollable="false">
          <lv_button name="button_2" width="54" height="25" style_bg_color="0x000000" style_bg_opa="0" style_border_width="0" style_radius="4" style_shadow_width="0" style_pad_all="0">
            <lv_label name="button_3" align="center" text="UNDO" style_text_font="montserrat_12" style_text_color="0x90caf9" style_text_align="center" />
            <subject_set_int_event subject="snackbar_body_div_4_open" value="0" />
          </lv_button>
          <lv_button name="close" width="30" height="30" style_bg_color="0x000000" style_bg_opa="0" style_border_width="0" style_radius="15" style_shadow_width="0" style_pad_all="0">
            <lv_label name="close_2" align="center" text="x" style_text_font="montserrat_16" style_text_color="0xffffff" style_text_align="center" />
            <subject_set_int_event subject="snackbar_body_div_4_open" value="0" />
          </lv_button>
        </lv_obj>
      </lv_obj>
      <bind_flag_if_eq subject="snackbar_body_div_4_open" flag="hidden" ref_value="0" />
    </lv_obj>
  </view>
</screen>
