    </lv_obj>
    <lv_obj name="nav" width="320" height="50" style_bg_opa="0" style_border_width="0" style_radius="0" style_shadow_width="0" style_pad_left="0" style_pad_right="0" style_pad_top="16" style_pad_bottom="0" flex_flow="row" style_flex_main_place="center" style_pad_row="0" style_pad_column="0" scrollable="false">
      <lv_button name="to_home" width="160" height="34" style_bg_color="0x334155" style_border_width="0" style_radius="6" style_shadow_width="0" style_pad_all="0">
        <lv_label name="label_3" align="center" text="Back to Home" style_text_font="montserrat_12" style_text_color="0xffffff" />
